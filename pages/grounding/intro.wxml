<!--pages/grounding/intro.wxml-->
<view class="container {{isDarkMode ? 'dark-theme' : 'light-theme'}}">
  <!-- 音乐控制按钮 -->
  <view class="music-control">
    <text class="music-note {{isMusicPlaying ? 'playing' : 'paused'}}" bindtap="toggleMusic">♪</text>
  </view>

  <!-- 主要内容 -->
  <view class="main-content">
    <!-- 标题 -->
    <view class="header">
      <view class="title">回到当下练习</view>
      <view class="subtitle">通过简单的练习放松身心，重新连接当下</view>
    </view>

    <!-- 说明内容 -->
    <view class="intro-content">
      <view class="section">
        <view class="section-title">练习包含什么？</view>
        <view class="step-list">
          <view class="step-item">
            <view class="step-number">1</view>
            <view class="step-text">
              <text class="step-name">深呼吸练习</text>
              <text class="step-desc">通过呼吸节奏放松身体，平静心情</text>
            </view>
          </view>
          <view class="step-item">
            <view class="step-number">2</view>
            <view class="step-text">
              <text class="step-name">5-4-3-2-1感官练习</text>
              <text class="step-desc">运用感官重新连接当下，缓解焦虑</text>
            </view>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="btn btn-primary forest-glow" bindtap="startPractice">
      开始练习
    </button>
    <button class="btn btn-outline" bindtap="skipIntro">
      跳过说明
    </button>
  </view>

  <!-- 底部署名 -->
  <view class="credit">
    <text class="credit-text">room800 | Music By Zøe</text>
  </view>
</view>