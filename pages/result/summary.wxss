/* pages/result/summary.wxss */

/* 深色主题页面背景 */
.dark-theme {
  background: linear-gradient(135deg, #1C2522 0%, #2A3A35 50%, #1C2522 100%) !important;
  min-height: 100vh;
  transition: background 0.5s ease;
}


.message-section {
  text-align: center;
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  padding: 0 40rpx;
  margin: 0 auto;
}

/* 像素风兔子IP */
.pixel-rabbit {
  display: inline-block;
  margin-bottom: 40rpx;
  animation: float 3s ease-in-out infinite;
}

.pixel-row {
  display: flex;
  justify-content: center;
}

.pixel {
  width: 8rpx;
  height: 8rpx;
  display: inline-block;
}

.pixel.transparent {
  background: transparent;
}

.pixel.body {
  background: var(--light-text-primary);
  border-radius: 1rpx;
}

.pixel.eye {
  background: var(--light-bg-primary);
  border-radius: 1rpx;
}

/* 深色模式下的像素风兔子 */
.dark-theme .pixel.body,
page.dark .pixel.body {
  background: var(--dark-text-primary);
}

.dark-theme .pixel.eye,
page.dark .pixel.eye {
  background: var(--dark-bg-primary);
}

/* 浮动动画 */
@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.completion-title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--light-text-primary);
  margin-bottom: 60rpx;
  animation: fadeInUp 0.6s ease-out 0.2s both;
}

.dark-theme .completion-title,
page.dark .completion-title {
  color: var(--dark-text-primary);
}

.message-group {
  margin-bottom: 40rpx;
}

.message-text {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--light-text-primary);
  margin-bottom: 20rpx;
  line-height: 1.4;
  animation: fadeInUp 0.6s ease-out both;
}

.message-text:nth-child(1) {
  animation-delay: 0.4s;
}

.message-text:nth-child(2) {
  animation-delay: 0.6s;
}

.dark-theme .message-text,
page.dark .message-text {
  color: var(--dark-text-primary);
}

.message-subtext {
  font-size: 28rpx;
  color: var(--light-text-secondary);
  animation: fadeInUp 0.6s ease-out 0.8s both;
}

.dark-theme .message-subtext,
page.dark .message-subtext {
  color: var(--dark-text-secondary);
}

.action-section {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  animation: fadeInUp 0.6s ease-out 1s both;
}

.credit {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  animation: fadeIn 0.6s ease-out 1.2s both;
}

.credit-text {
  font-size: 24rpx;
  color: var(--light-text-tertiary);
}

.dark-theme .credit-text,
page.dark .credit-text {
  color: var(--dark-text-tertiary);
}

/* 动画效果 */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}